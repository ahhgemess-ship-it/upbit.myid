# ============ Upbit Store — server env ============
# Salin ke server/.env untuk lokal, dan set yang sama di Vercel (Project Settings → Environment Variables).

# --- Database: Neon Postgres ---
# Neon dashboard → Connection string.
#  - DATABASE_URL : pakai endpoint POOLED (host ada "-pooler") untuk runtime serverless.
#  - DIRECT_URL   : endpoint langsung (untuk prisma db push / migrate). Boleh sama jika tak pakai pooler.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Keamanan (WAJIB di produksi) ---
# String acak panjang. Contoh siap pakai sudah digenerate untukmu di DEPLOY.md.
JWT_SECRET="ganti-dengan-string-acak-panjang"
# 64 karakter hex untuk AES-256 (opsional; jika kosong diturunkan dari JWT_SECRET).
ENCRYPTION_KEY=""

# --- Google OAuth ---
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
ADMIN_EMAILS="ikhwanda466@gmail.com"

# --- CORS (opsional) — samakan dengan domain Vercel ---
CLIENT_ORIGIN="https://NAMA-PROYEK.vercel.app"

# --- Vercel Blob (penyimpanan upload di produksi) ---
# Otomatis terisi di Vercel saat integrasi Blob diaktifkan. Kosongkan di lokal (pakai disk).
BLOB_READ_WRITE_TOKEN=""

# --- Cron pengacak rating (opsional) ---
CRON_SECRET=""

# --- Email / nodemailer (opsional) ---
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="Upbit Store <no-reply@domainmu>"
