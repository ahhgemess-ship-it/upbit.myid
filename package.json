{
  "name": "upbit-store",
  "private": true,
  "version": "1.0.0",
  "description": "Upbit Store, marketplace produk digital (frontend dan backend dalam satu repo).",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n SERVER,WEB -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "test": "npm --prefix server test",
    "dev:server": "cd server && npm run dev",
    "dev:web": "cd app && npm run dev",
    "build": "cd app && npm install && npm run build",
    "postinstall": "npx prisma generate --schema=server/prisma/schema.prisma || true",
    "db:setup": "cd server && npx prisma db push && node prisma/seed.js && node prisma/seedReviews.js",
    "install:all": "cd server && npm install && cd ../app && npm install && cd .. && npm install",
    "start": "cd server && npm start"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/hin": "^1.0.0",
    "@tesseract.js-data/jpn": "^1.0.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "@vercel/blob": "^2.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.1",
    "prisma": "^5.22.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
